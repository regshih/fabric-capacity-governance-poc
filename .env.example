# ===========================================================================
# Fabric Capacity Governance POC - example configuration
#
# Copy to `.env` and fill in YOUR values. `.env` is gitignored.
#
#   cp .env.example .env
#
# NEVER commit a populated .env. Every value below is intentionally blank or
# a safe non-environment-specific default.
# ===========================================================================

# --- Azure context --------------------------------------------------------
# Leave blank to use whatever `az account show` currently reports.
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=

# Resource group that owns the POC resources (automation account, and the
# POC capacity when CAPACITY_MODE=create). Policy is assigned at this scope.
RESOURCE_GROUP_NAME=
LOCATION=

# --- Capacity selection ---------------------------------------------------
# existing = discover and validate a capacity you already own (read-only by
#            default; see ALLOW_EXISTING_CAPACITY_STATE_CHANGE)
# create   = create a small POC capacity dedicated to this exercise
CAPACITY_MODE=existing

FABRIC_CAPACITY_NAME=

# Capacity administrator. A user principal name (UPN), e.g. someone@contoso.com,
# or a service principal object id. Required only when CAPACITY_MODE=create.
FABRIC_CAPACITY_ADMIN=

# Only used when CAPACITY_MODE=create. Do not raise this above F2 for a POC.
FABRIC_SKU=F2

# --- Safety flags (all default to the SAFE value) -------------------------
# Must be true before this POC will CREATE a Fabric capacity.
ALLOW_CAPACITY_CREATION=false

# Must be true before this POC will pause/resume a capacity it did NOT create.
# When false, the pause/resume test against an existing capacity is skipped
# and reported as NOT VALIDATED rather than silently changing your state.
ALLOW_EXISTING_CAPACITY_STATE_CHANGE=false

# Must be true before cleanup.py will delete anything at all.
ALLOW_POC_RESOURCE_DELETION=false

# Must be true before the deployer changes an Automation account that is not
# proven to belong to this POC by the ignored manifest and matching tags.
ALLOW_EXISTING_AUTOMATION_MODIFICATION=false

# --- Which POCs to run ----------------------------------------------------
ENABLE_AUTOMATION=true
ENABLE_RBAC_POC=true
ENABLE_POLICY_POC=true

# --- Azure Automation -----------------------------------------------------
AUTOMATION_ACCOUNT_NAME=

# REQUIRED when ENABLE_SCHEDULES=true. There is no safe default: a schedule
# in the wrong time zone pauses a capacity in the middle of someone's day.
# Use an Azure Automation supported time zone id, e.g.:
#   "UTC", "Pacific Standard Time", "W. Europe Standard Time", "India Standard Time"
AUTOMATION_TIME_ZONE=

# 24-hour HH:MM in AUTOMATION_TIME_ZONE.
RESUME_TIME=07:00
PAUSE_TIME=19:00

# Schedules are NOT created unless this is true.
ENABLE_SCHEDULES=false

# --- Azure Policy ---------------------------------------------------------
# Comma-separated list of Fabric F-SKUs the policy permits.
ALLOWED_FABRIC_SKUS=F2,F4,F8

# Audit | Deny | Disabled. Deny must be an explicit, deliberate choice.
POLICY_EFFECT=Audit

# --- RBAC -----------------------------------------------------------------
# Optional. Object id of an EXISTING principal (user, group, or service
# principal) to receive the custom role assignment during the RBAC POC.
# Leave blank to have the POC emit the assignment commands without running
# them. This POC never creates identities.
TEST_PRINCIPAL_OBJECT_ID=

# Principal type of TEST_PRINCIPAL_OBJECT_ID: User | Group | ServicePrincipal.
# Azure rejects the assignment if this does not match the real principal, and a
# managed identity or app registration is a ServicePrincipal, NOT a User.
TEST_PRINCIPAL_TYPE=User
